
    /* ── HR nav (portal-layout.js) ── */
    localStorage.setItem('userRole', 'hr');

    /* ── Candidate data (merged from original source) ── */
    /* ── API Configuration ── */
    const JOBS_API_BASE = (typeof AUTH_API_BASE !== 'undefined') ? AUTH_API_BASE : '';
    const token = localStorage.getItem('access_token');

    let activeStageFilter = '';
    let applicantsData = [];
    let currentPageNum = 1;
    const itemsPerPage = 10;

    // Redirect to login if token is missing
    if (!token) {
      window.location.href = '/mss-career-portal/home';
    }

    /* ── Load Units into Filter Dropdown ── */
    function loadUnitOptions() {
      fetch(JOBS_API_BASE + '/auth/units')
      .then(res => {
        if (!res.ok) throw new Error();
        return res.json();
      })
      .then(units => {
        const select = document.getElementById('fUnit');
        select.innerHTML = '<option value="">All Units</option>';
        units.forEach(u => {
          const opt = document.createElement('option');
          opt.value = u.unit_name;
          opt.textContent = u.unit_name;
          select.appendChild(opt);
        });
      })
      .catch(err => console.error('Failed to load unit filter options:', err));
    }

    /* ── Fetch Applicants from API ── */
    function fetchApplicants() {
      const q = document.getElementById('searchInput').value;
      const unit = document.getElementById('fUnit').value;
      const stage = document.getElementById('fStage').value || activeStageFilter;
      const exp = document.getElementById('fExp').value;

      const params = new URLSearchParams();
      if (unit) params.append('unit', unit);
      if (stage) params.append('stage', stage);
      if (q) params.append('search', q);
      if (exp) params.append('exp', exp);

      fetch(JOBS_API_BASE + '/jobs/applicants?' + params.toString(), {
        headers: { 'Authorization': 'Bearer ' + token }
      })
      .then(res => {
        if (!res.ok) throw new Error();
        return res.json();
      })
      .then(data => {
        // Update stats card values
        document.querySelector('.sc-total .stat-value').textContent = data.stats.total;
        document.querySelector('.sc-interview .stat-value').textContent = data.stats.interview;
        document.querySelector('.sc-offers .stat-value').textContent = data.stats.offers;
        document.querySelector('.sc-onboarding-progress .stat-value').textContent = data.stats.onboarding;
        document.querySelector('.sc-onboarding .stat-value').textContent = data.stats.onboarded;

        if (data.stats.deltas) {
          document.querySelector('.sc-total .stat-delta').textContent = data.stats.deltas.total;
          document.querySelector('.sc-offers .stat-delta').textContent = data.stats.deltas.offers;
          document.querySelector('.sc-onboarding-progress .stat-delta').textContent = data.stats.deltas.onboarding;
          document.querySelector('.sc-onboarding .stat-delta').textContent = data.stats.deltas.onboarded;
        }

        // Update subtitle
        const subtitle = document.getElementById('pageSubtitle');
        if (subtitle) {
          subtitle.textContent = `${data.stats.total} total candidates across all positions`;
        }

        // Render stage chips
        renderStageChips(data.chips, data.stats.total);

        // Render table rows
        applicantsData = data.applicants;
        currentPageNum = 1;
        renderApplicants(applicantsData);
      })
      .catch(err => {
        console.error('Failed to load applicants:', err);
        const tbody = document.getElementById('applicantBody');
        if (tbody) {
          tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;padding:40px;color:var(--text3);">Unable to load candidates. Please try again.</td></tr>`;
        }
      });
    }

    /* ── Build stage chips dynamically ── */
    const STAGE_CONFIG = [
      { name: 'All', color: '#444441', bg: '#F1EFE8' },
      { name: 'Prescreen Rejected', color: '#534AB7', bg: '#EEEDFE' },
      { name: 'Screened', color: '#185FA5', bg: '#E6F1FB' },
      { name: 'Interview', color: '#BA7517', bg: '#FAEEDA' },
      { name: 'Offer', color: '#534AB7', bg: '#EEEDFE' },
      { name: 'Offer Accepted', color: '#3B6D11', bg: '#EAF3DE' },
      { name: 'Onboarding', color: '#155E75', bg: '#CFFAFE' },
      { name: 'Onboarded', color: '#0F6E56', bg: '#E1F5EE' },
      { name: 'Rejected', color: '#A32D2D', bg: '#FCEBEB' },
    ];

    function renderStageChips(chipsData, totalCount = 0) {
      const chipsEl = document.getElementById('stageChips');
      chipsEl.innerHTML = '';
      STAGE_CONFIG.forEach(s => {
        const count = s.name === 'All' ? totalCount : (chipsData[s.name] || 0);
        const chip = document.createElement('button');
        chip.className = 'stage-chip';
        chip.dataset.stage = s.name;
        chip.style.cssText = `background:${s.bg};color:${s.color};border-color:${s.color}30;`;
        if ((s.name === 'All' && !activeStageFilter) || activeStageFilter === s.name) {
          chip.style.outline = `2px solid ${s.color}`;
        }
        chip.innerHTML = `${s.name}<span class="chip-count" style="background:${s.color}25;color:${s.color};">${count}</span>`;
        chip.onclick = () => {
          activeStageFilter = s.name === 'All' ? '' : (activeStageFilter === s.name ? '' : s.name);
          document.getElementById('fStage').value = activeStageFilter;
          fetchApplicants();
        };
        chipsEl.appendChild(chip);
      });
    }

    /* ── Helpers ── */
    function stageBadge(stage) {
      const map = {
        'Prescreen Rejected': 'badge-rejected', 'Screened': 'badge-screened', 'Interview': 'badge-interview',
        'Offer': 'badge-offer', 'Offer Accepted': 'badge-accepted',
        'Onboarding': 'badge-onboarding-progress',
        'Onboarded': 'badge-onboarding', 'Rejected': 'badge-rejected',
        'Awaiting Offer': 'badge-offer'
      };
      return `<span class="badge ${map[stage] || ''}">${stage}</span>`;
    }

    function interviewStatusHtml(s) {
      if (!s) return `<span style="color:var(--text3);">—</span>`;
      const sLower = s.toLowerCase();
      if (sLower === 'scheduled') return `<span class="interview-status status-scheduled"><span class="status-dot"></span>Scheduled</span>`;
      if (sLower === 'completed') return `<span class="interview-status status-completed"><span class="status-dot"></span>Completed</span>`;
      if (sLower === 'pending') return `<span class="interview-status status-pending"><span class="status-dot"></span>Pending</span>`;
      if (sLower === 'selected') return `<span class="interview-status status-selected"><span class="status-dot"></span>Selected</span>`;
      if (sLower === 'rejected') return `<span class="interview-status status-rejected"><span class="status-dot"></span>Rejected</span>`;
      if (sLower === 'hold' || sLower === 'on hold') return `<span class="interview-status status-hold"><span class="status-dot"></span>${s}</span>`;
      if (sLower === 'next_round' || sLower === 'next round') return `<span class="interview-status status-next-round"><span class="status-dot"></span>Next Round</span>`;
      return `<span style="color:var(--text3);">${s}</span>`;
    }

    function avatarGradient(name) {
      const p = [
        ['#6366f1', '#8b5cf6'], ['#3b82f6', '#06b6d4'], ['#10b981', '#0891b2'],
        ['#f59e0b', '#ef4444'], ['#534AB7', '#185FA5'], ['#0F6E56', '#3B6D11'], ['#BA7517', '#A32D2D']
      ];
      return p[name.charCodeAt(0) % p.length].join(',');
    }

    /* ── Render table ── */
    function renderApplicants(list) {
      const tbody = document.getElementById('applicantBody');
      tbody.innerHTML = '';
      if (!list.length) {
        tbody.innerHTML = `<tr><td colspan="9" style="text-align:center;padding:40px;color:var(--text3);">No candidates match your filters</td></tr>`;
        document.getElementById('resultCount').textContent = '0 candidates';
        const pg = document.getElementById('pagination');
        if (pg) pg.style.display = 'none';
        return;
      } else {
        const pg = document.getElementById('pagination');
        if (pg) {
          buildPagination(list.length, itemsPerPage);
        }
      }
      const startIdx = (currentPageNum - 1) * itemsPerPage;
      const pageList = list.slice(startIdx, startIdx + itemsPerPage);
      pageList.forEach((c, index) => {
        let displayStage = c.stage;
        let showActions = true;
        
        const advancedStages = ['Offer', 'Offer Accepted', 'Onboarding', 'Onboarded', 'Rejected'];
        if (c.interviewStatus === 'Selected' && !advancedStages.includes(c.stage)) {
          displayStage = 'Awaiting Offer';
          showActions = false;
        }
        
        const allowedStages = ['PreScreen-Reject', 'Interview', 'Screened'];
        const canAction = showActions && allowedStages.includes(c.stage);
        
        const tr = document.createElement('tr');
        tr.innerHTML = `
      <td style="font-weight:600;color:var(--text2);"> ${startIdx + index + 1} </td>
      <td>
        <div class="td-flex">
          <div class="avatar-sm" style="background:linear-gradient(135deg,${avatarGradient(c.name)});">${c.avatar}</div>
          <div>
            <div class="candidate-name">${c.name}</div>
            <div class="candidate-id">${c.mss_app_no || 'APP-' + String(c.id).padStart(4, '0')}</div>
          </div>
        </div>
      </td>
      <td style="color:var(--text2);max-width:180px;">
        <div>${c.job}</div>
        ${c.job_status === 'closed' ? `<div class="job-closed-tag"><i class="ti ti-lock" aria-hidden="true"></i>Job Closed</div>` : ''}
      </td>
      <td style="color:var(--text3);">${c.unit || '—'}</td>
      <td style="color:var(--text3);white-space:nowrap;">${c.appliedDate}</td>
      <td style="font-weight:500;">${c.exp}</td>
      <td>${stageBadge(displayStage)}</td>
      <td>${interviewStatusHtml(c.interviewStatus)}</td>
      <td style="text-align:center;">
        <div style="display:flex;gap:6px;flex-wrap:wrap;justify-content:center;">
          <button class="action-btn blue" title="Profile" onclick="event.stopPropagation(); localStorage.setItem('candidateId', '${c.id}'); location.href='/mss-career-portal/hr/candidate-profile?name=' + encodeURIComponent('${c.name}') + '&job_title=' + encodeURIComponent('${c.job}')">
              <i class="ti ti-user"></i>
          </button>
          ${(showActions && (c.stage === 'Screened' || c.interviewStatus === 'Next Round' || c.interviewStatus === 'Cancelled') && c.interviewStatus !== 'Completed' && c.interviewStatus !== 'Scheduled' && c.interviewStatus !== 'Selected') ? `<button class="action-btn green" title="Schedule Interview" onclick="event.stopPropagation(); scheduleInterviewModal(${c.id}, '${c.name}', ${c.job_id})"><i class="ti ti-calendar-event"></i></button>` : ''}
          ${canAction ? `<button class="action-btn red" title="Reject Candidate" onclick="event.stopPropagation(); rejectCandidateModal(${c.id}, '${c.name}')"><i class="ti ti-x"></i></button>` : ''}
        </div>
      </td>`;
        tbody.appendChild(tr);
      });
      document.getElementById('resultCount').textContent = `${list.length} candidate${list.length !== 1 ? 's' : ''}`;
    }

    /* ── Filter ── */
    function filterApplicants() {
      // Keep the stage chips in sync with the dropdown so a stale chip
      // selection doesn't override "All Stages" when the dropdown is used.
      activeStageFilter = document.getElementById('fStage').value;
      fetchApplicants();
    }

    /* ── Modal helper ── */
    function showModal(html) {
      const ov = document.createElement('div');
      ov.className = 'modal-overlay';
      ov.innerHTML = `<div class="modal-box">${html}</div>`;
      ov.addEventListener('click', e => { if (e.target === ov) ov.remove(); });
      document.body.appendChild(ov);
    }

    /* ── Schedule Interview modal ── */
    function scheduleInterviewModal(applicantId, name, jobId) {
      showModal(`
    <div class="modal-title"><i class="ti ti-calendar" aria-hidden="true"></i> Schedule Interview</div>
    <p>Scheduling interview for <strong>${name}</strong></p>
    <div class="form-grid">
      <div class="form-group span2">
        <label>Interview Round</label>
        <input type="text" id="schRound">
      </div>
      <div class="form-group">
        <label>Mode</label>
        <select id="interviewMode" onchange="toggleInterviewModeField()">
          <option value="online">Online</option>
          <option value="offline">In-Person</option>
        </select>
      </div>
      <div class="form-group">
        <label>Date</label><input type="date" id="schDate" value="${new Date().toISOString().split('T')[0]}" min="${new Date().toISOString().split('T')[0]}">
      </div>
      <div class="form-group span2" style="display:flex; flex-direction:row; gap:10px;">
        <div style="flex:1; display:flex; flex-direction:column; gap:5px;">
          <label>Start Time</label><input type="time" id="schTime" value="10:00">
        </div>
        <div style="flex:1; display:flex; flex-direction:column; gap:5px;">
          <label>End Time</label><input type="time" id="schEndTime" value="11:00">
        </div>
      </div>
      <div class="form-group span2" id="dynamicModeContainer">
        <label id="modeLabel">Meeting Link</label>
        <input type="text" id="modeInput" placeholder="Enter online meeting URL">
      </div>
      <div class="form-group span2">
        <label>Interviewer</label>
        <select id="schInterviewer">
          <option value="">Loading interviewers…</option>
        </select>
      </div>
    </div>
    <div class="modal-actions">
      <button class="header-btn" onclick="document.querySelector('.modal-overlay').remove()">Cancel</button>
      <button class="btn-primary" onclick="submitSchedule(${applicantId}, ${jobId})"><i class="ti ti-calendar" aria-hidden="true"></i> Confirm Schedule</button>
    </div>`);
      loadInterviewers('schInterviewer');
    }

    function submitSchedule(applicantId, jobId) {
      const round = document.getElementById('schRound').value.trim();
      const mode = document.getElementById('interviewMode').value;
      const schDate = document.getElementById('schDate').value;
      const schTime = document.getElementById('schTime').value;
      const schEndTime = document.getElementById('schEndTime').value;
      const modeInput = document.getElementById('modeInput').value.trim();
      const interviewer = document.getElementById('schInterviewer').value.trim();

      if (!round || !schDate || !schTime || !schEndTime) {
        if (window.showToast) window.showToast('Please fill out all required fields (Round, Date, Start Time, End Time).', 'error');
        return;
      }

      if (!interviewer) {
        if (window.showToast) window.showToast('Please select an interviewer.', 'error');
        return;
      }

      // Combine date and time to ISO string
      const scheduledAtIso = `${schDate}T${schTime}:00`;
      const endTimeAtIso = `${schDate}T${schEndTime}:00`;

      const payload = {
        job_id: jobId,
        job_applicant_id: applicantId,
        interview_round: round,
        scheduled_at: scheduledAtIso,
        end_time_at: endTimeAtIso,
        interview_mode: mode,
        meeting_link: mode === 'online' ? modeInput : null,
        location: mode === 'offline' ? modeInput : null,
        interviewer_name: interviewer
      };

      fetch(JOBS_API_BASE + '/job-interviews/', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token
        },
        body: JSON.stringify(payload)
      })
      .then(res => {
        if (!res.ok) throw new Error('Failed to schedule interview');
        return res.json();
      })
      .then(() => {
        if (window.showToast) window.showToast('Interview scheduled successfully!', 'success');
        document.querySelector('.modal-overlay').remove();
        fetchApplicants();
      })
      .catch(err => {
        console.error(err);
        if (window.showToast) window.showToast('Error scheduling interview: ' + err.message, 'error');
      });
    }

    /* ── Interviewer dropdown loader ── */
    function loadInterviewers(selectId) {
      fetch(JOBS_API_BASE + '/job-interviews/school-admins', {
        headers: { 'Authorization': 'Bearer ' + token }
      })
      .then(res => res.ok ? res.json() : Promise.reject(res))
      .then(list => {
        const sel = document.getElementById(selectId);
        if (!sel) return;
        if (!list.length) {
          sel.innerHTML = '<option value="">No school admins found (role_id=7)</option>';
          return;
        }
        sel.innerHTML = '<option value="">Select an interviewer...</option>' + list.map(i => {
          const unitDisplay = i.unit_name ? ` (Unit: ${i.unit_name})` : (i.unit_id ? ` (Unit ID: ${i.unit_id})` : '');
          return `<option value="${i.email}">${i.email}${unitDisplay}</option>`;
        }).join('');
      })
      .catch(() => {
        const sel = document.getElementById(selectId);
        if (!sel) return;
        const wrapper = sel.parentElement;
        const input = document.createElement('input');
        input.type = 'text';
        input.id = selectId;
        input.placeholder = 'Enter interviewer name';
        wrapper.replaceChild(input, sel);
      });
    }

    /* ── Reject Candidate modal ── */
    function rejectCandidateModal(applicantId, name) {
      showModal(`
    <div class="modal-title">Reject Candidate</div>
    <p>You are about to reject <strong>${name}</strong> from this position.</p>
    <div class="form-group">
      <label>Rejection Reason *</label>
      <select id="rejReason">
        <option>Does not meet experience requirements</option>
        <option>Qualification mismatch</option>
        <option>Position filled</option>
        <option>Better candidates selected</option>
      </select>
    </div>
    <div class="form-group" style="margin-top:12px;">
      <label>Additional Notes</label>
      <textarea id="rejNotes" placeholder="Optional feedback…"></textarea>
    </div>
    <div class="modal-actions">
      <button class="header-btn" onclick="document.querySelector('.modal-overlay').remove()">Cancel</button>
      <button class="btn-danger" onclick="submitRejection(${applicantId})">Confirm Rejection</button>
    </div>`);
    }

    function submitRejection(applicantId) {
      const reason = document.getElementById('rejReason').value;
      const notes = document.getElementById('rejNotes').value.trim();

      fetch(JOBS_API_BASE + `/jobs/applicants/${applicantId}/status`, {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token
        },
        body: JSON.stringify({
          status: 'rejected',
          remarks: `${reason}. Notes: ${notes}`
        })
      })
      .then(res => {
        if (!res.ok) throw new Error('Rejection request failed');
        return res.json();
      })
      .then(() => {
        if (window.showToast) window.showToast('Candidate rejected.', 'error');
        document.querySelector('.modal-overlay').remove();
        fetchApplicants();
      })
      .catch(err => {
        console.error(err);
        if (window.showToast) window.showToast('Error rejecting candidate.', 'error');
      });
    }

    /* ── Init Page ── */
    loadUnitOptions();
    fetchApplicants();

    /* ── Pagination ── */
    function goToPage(pageNum, totalPages) {
      currentPageNum = Math.min(Math.max(pageNum, 1), totalPages);
      renderApplicants(applicantsData);
    }

    function buildPagination(total, perPage) {
      const pg = document.getElementById('pagination');
      if (!pg) return;

      const totalPages = Math.ceil(total / perPage) || 1;
      buildWindowedPagination(pg, {
        total, perPage, currentPage: currentPageNum, maxButtons: 5,
        onPageChange: (page) => goToPage(page, totalPages)
      });
    }
    
    // Handler function to toggle label and placeholder text
    function toggleInterviewModeField() {
      const mode = document.getElementById('interviewMode').value;
      const label = document.getElementById('modeLabel');
      const input = document.getElementById('modeInput');

      if (mode === 'online') {
        label.innerText = 'Meeting Link';
        input.placeholder = 'https://meet.google.com/...';
        input.value = '';
      } else {
        label.innerText = 'Location';
        input.placeholder = 'Enter institution address';
        input.value = '';
      }
    }

  